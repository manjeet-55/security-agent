{
  "name": "secagent",
  "version": "0.1.0",
  "description": "A security check you run in your project folder: it asks what to check, asks for permission, scans code, websites and servers, and writes a plain-language Markdown and PDF report. Deterministic, with an MCP server for AI assistants.",
  "type": "module",
  "bin": {
    "secagent": "dist/cli.js"
  },
  "files": [
    "dist",
    "knowledge",
    "agent",
    "assets"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "demo:setup": "tsx scripts/demo-setup.ts",
    "demo:server": "tsx scripts/demo-server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "pdfkit": "0.20.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pdfkit": "0.17.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "keywords": [
    "security",
    "scanner",
    "cli",
    "mcp",
    "report",
    "secrets",
    "headers",
    "tls",
    "devsecops"
  ]
}
